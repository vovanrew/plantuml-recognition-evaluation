# Unpacked benchmark data. The tracked artifact is data.zip; unzipping it at the
# repository root recreates data/, which is not committed back. The one exception
# is the standardized test images, which do not fit in data.zip as one file.
data/*
!data/puml_images_1568/

# Scorer-v2 re-scores of the stored runs (element_f1/, relationship_f1/, _bridge/).
# The tracked artifact is data_v2.zip, the result files only; unzipping it at the
# repository root recreates data_v2/ without the extracted blocks.
data_v2/

# The renderer JAR is pinned by version in README.md, not vendored. The two
# extractor JARs the scorers ran with are tracked (README, "The structural extractor").
*.jar
!plantuml-stats-extractor-v1.jar
!plantuml-stats-extractor-v2.jar

# Credentials. Never commit an API key.
*-KEY.txt
*.key
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Manuscript, kept locally for reference only. Never committed: the published
# record is the journal's, and the repo is the code and data release.
manuscript/
